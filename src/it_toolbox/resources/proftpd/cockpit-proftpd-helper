    "set-permissions": cmd_set_permissions,
    "delete-user": cmd_delete_user,
}


def main() -> int:
    if len(sys.argv) != 2 or sys.argv[1] not in _SUBCOMMANDS:
        print(json.dumps({"error": f"usage: {sys.argv[0]} <{'|'.join(_SUBCOMMANDS)}>"}))
        return 1

    raw = sys.stdin.read()
    try:
        args = json.loads(raw) if raw.strip() else {}
    except json.JSONDecodeError as e:
        print(json.dumps({"error": f"invalid JSON on stdin: {e}"}))
        return 1

    try:
        result = _SUBCOMMANDS[sys.argv[1]](args)
    except HelperError as e:
        result = {"error": str(e)}
    except Exception as e:  # noqa: BLE001 - last resort; still needs to reach the UI as text
        result = {"error": f"unexpected error: {e}"}

    # Deliberately exit 0 even for an {"error": ...} result: this is an
    # *application*-level outcome (bad input, duplicate user, etc.) that
    # the frontend needs to display normally, not a process failure.
    # cockpit.spawn's promise rejects on a non-zero exit, and its
    # rejection can carry more than one value (exception *and* any
    # stdout produced before the failure) -- a shape that doesn't map
    # cleanly onto a single `catch` block with async/await (see
    # https://github.com/cockpit-project/cockpit/issues/14682). Reserving
    # a non-zero exit for the two cases above (bad subcommand, malformed
    # JSON) sidesteps that entirely: those can only happen from a
    # frontend/integration bug, never from something a user did, so
    # there's nothing useful to show them anyway -- letting
    # cockpit.spawn's own rejection path handle it is fine.
    print(json.dumps(result))
    return 0


if __name__ == "__main__":
    sys.exit(main())
